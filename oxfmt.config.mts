      // ReadMe-flavored docs. Oxfmt reindents magic blocks and sample fences.
      '**/*.md',
      '**/*.mdx',

      // Parser inputs and expected outputs. Reformatting these changes what the tests assert.
      '__tests__/fixtures/',
      '__tests__/regression/fixtures/',
      '__tests__/migration/**/fixtures/',
      '__tests__/lib/mdast/**/in.mdx',
      '__tests__/lib/mdast/**/out.json',
      '__tests__/lib/exports/input/',
      '__tests__/**/__snapshots__/',
      '__tests__/browser/__image_snapshots__/',
    ],
  }),
);
